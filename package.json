{
  "name": "designkata",
  "version": "0.1.0",
  "private": true,
  "description": "LLD practice with feedback you can check. Design, submit, get evidence-anchored feedback, take the twist, try again.",
  "author": "Devank Srivastava",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --disable-warning=ExperimentalWarning server/src/index.ts --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "check:text": "node scripts/check-text.mjs",
    "check:llm": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/scripts/check-llm.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mermaid": "^11.17.2",
    "mongoose": "^9.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
