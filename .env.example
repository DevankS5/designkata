# Copy to .env. Every value is optional for local runs.

# MongoDB connection string. Without it, dev mode starts a local in-memory
# MongoDB that keeps its data in .data/mongo between restarts.
MONGO_URI=

# OpenRouter key for the AI rubric review. Without it, feedback is rules-only
# and the UI says "AI review not configured".
OPENROUTER_API_KEY=
LLM_MODEL=

PORT=3000

